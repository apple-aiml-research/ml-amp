{
  "format": "amp-route-policy-1",
  "name": "amp1_assistive",
  "rules": [
    {"methods": ["GET", "POST"], "path": "api/agent/check"},
    {"methods": ["GET", "POST"], "path": "api/agent/check_batch"},
    {"methods": ["GET", "POST"], "path": "api/agent/define_object"},
    {"methods": ["GET", "POST"], "path": "api/agent/fk"},
    {"methods": ["GET", "POST"], "path": "api/agent/forget_object"},
    {"methods": ["GET", "POST"], "path": "api/agent/ik"},
    {"methods": ["GET", "POST"], "path": "api/agent/ik_batch"},
    {"methods": ["GET", "POST"], "path": "api/agent/observation"},
    {"methods": ["GET", "POST"], "path": "api/agent/reperceive"},
    {"methods": ["GET", "POST"], "path": "api/agent/robot"},
    {"methods": ["GET", "POST"], "path": "api/agent/segment"},
    {"methods": ["GET", "POST"], "path": "api/agent/wait"},
    {"methods": ["GET", "POST"], "pattern": "api/agent/depth/([A-Za-z0-9_]+)(?:/\\d+)?", "key": "api/agent/depth/{1}"},
    {"methods": ["GET", "POST"], "pattern": "api/agent/object_points/([A-Za-z0-9_]+)", "key": "api/agent/object_points"},
    {"methods": ["GET"], "path": "api/assist/steps"},
    {"methods": ["GET"], "path": "api/cloud"},
    {"methods": ["GET"], "path": "api/scene"},
    {"methods": ["GET"], "pattern": "api/frame/([A-Za-z0-9_]+)(?:/\\d+)?", "key": "api/frame/{1}"},
    {"methods": ["GET"], "pattern": "api/cloud(?:/(?:cams|stride|max_depth|crop)=[A-Za-z0-9_.,%-]*)+", "key": "api/cloud"},
    {"methods": ["POST"], "path": "api/assist/check"},
    {"methods": ["POST"], "path": "api/assist/execute"},
    {"methods": ["POST"], "path": "api/assist/grasps"},
    {"methods": ["POST"], "path": "api/assist/object_at"},
    {"methods": ["POST"], "path": "api/assist/places"},
    {"methods": ["POST"], "path": "api/assist/plan"},
    {"methods": ["POST"], "path": "api/assist/steps/add"},
    {"methods": ["POST"], "path": "api/assist/steps/clear"},
    {"methods": ["POST"], "path": "api/assist/steps/delete"},
    {"methods": ["POST"], "path": "api/assist/steps/execute"},
    {"methods": ["POST"], "path": "api/assist/steps/update"},
    {"methods": ["POST"], "path": "api/gripper"},
    {"methods": ["POST"], "path": "api/hold"},
    {"methods": ["POST"], "path": "api/home"},
    {"methods": ["POST"], "path": "api/motion/base"},
    {"methods": ["POST"], "path": "api/pick"},
    {"methods": ["POST"], "path": "api/plan/execute"},
    {"methods": ["POST"], "path": "api/plan/preview"},
    {"methods": ["POST"], "path": "api/stop"}
  ],
  "executes": ["api/assist/execute", "api/assist/steps/execute", "api/gripper", "api/hold",
               "api/home", "api/motion/base", "api/plan/execute"]
}
